{
    "name": "express-ts",
    "version": "1.0.0",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=dev tsx watch src/server.ts",
        "build": "swc ./src --source-maps --copy-files --out-dir dist",
        "build:tsc": "tsc && tsc-alias",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "start": "npm run build && cross-env NODE_ENV=prod node dist/src/server.js",
        "clean": "rimraf dist",
        "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
        "format": "prettier --write ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "mongoose": "^8.16.1",
        "reflect-metadata": "^0.2.2",
        "tslib": "^2.8.1",
        "typedi": "^0.10.0",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@swc/cli": "^0.7.7",
        "@swc/core": "^1.12.9",
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.3",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "@vitest/coverage-v8": "^4.1.11",
        "cross-env": "^7.0.3",
        "eslint": "^9.29.0",
        "husky": "^9.1.7",
        "mongodb-memory-server": "^11.2.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    }
}
