{
    "name": "express-ts",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "dev": "NODE_ENV=dev tsx watch src/server.ts",
        "build": "swc ./src -d dist/test --source-maps --copy-files --out-dir dist",
        "build:tsc": "tsc && tsc-alias",
        "start": "npm run build && cross-env NODE_ENV=prod node dist/src/server.js",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "format": "prettier --write ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "mongoose": "^8.16.1",
        "node-vault": "^0.10.5",
        "rimraf": "^6.0.1",
        "tslib": "^2.8.1",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@swc/cli": "^0.7.7",
        "@swc/core": "^1.12.9",
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.3",
        "@types/node-vault": "^0.9.1",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.29.0",
        "husky": "^9.1.7",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    }
}
