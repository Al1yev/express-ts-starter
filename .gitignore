# Bog'liqliklar
/node_modules

# Muhit o'zgaruvchilari - hech qachon commit qilinmaydi.
# Root uchun ham, ichki papkalar uchun ham (`/` prefiksi faqat root'ga tegishli).
.env
.env.*
/.env*
