{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "importHelpers": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmitOnError": true,
        "isolatedModules": false,
        "pretty": true,
        "baseUrl": "src",
        "rootDir": "src",
        // `build` (swc) `dist/src/` ga chiqaradi va `main`/`start` ham shu yo'lni
        // ko'rsatadi. `build:tsc` ham xuddi shu joyga chiqarishi uchun `dist/src`.
        "outDir": "dist/src",
        "paths": {
            "@/*": ["*"],
            "@config/*": ["config/*"],
            "@config": ["config/index.ts"],
            "@controllers/*": ["controllers/*"],
            "@controllers": ["controllers/index.ts"],
            "@database/*": ["database/*"],
            "@database": ["database/index.ts"],
            "@dtos/*": ["dtos/*"],
            "@dtos": ["dtos/index.ts"],
            "@exceptions/*": ["exceptions/*"],
            "@exceptions": ["exceptions/index.ts"],
            "@interfaces/*": ["interfaces/*"],
            "@interfaces": ["interfaces/index.ts"],
            "@middlewares/*": ["middlewares/*"],
            "@middlewares": ["middlewares/index.ts"],
            "@models/*": ["models/*"],
            "@models": ["models/index.ts"],
            "@routers/*": ["routers/*"],
            "@routers": ["routers/index.ts"],
            "@services/*": ["services/*"],
            "@services": ["services/index.ts"],
            "@utils/*": ["utils/*"],
            "@utils": ["utils/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.json", ".env"],
    "exclude": ["node_modules"]
}
